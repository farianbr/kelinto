{
  "name": "cellvix",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cellvix — B2B wholesale electronics parts marketplace",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "start": "npm run start --workspace server",
    "dev": "concurrently -n server,client -c magenta,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "npm run dev --workspace client",
    "dev:server": "npm run dev --workspace server",
    "build": "npm run build --workspace client",
    "seed": "npm run seed --workspace server",
    "seed:demo": "npm run seed:demo --workspace server --",
    "backfill": "npm run backfill --workspace server --",
    "seed:content": "npm run seed:content --workspace server",
    "seed:articles": "npm run seed:articles --workspace server",
    "seed:reviews": "npm run seed:reviews --workspace server",
    "seed:quotes": "npm run seed:quotes --workspace server",
    "seed:expense-categories": "npm run seed:expense-categories --workspace server",
    "seed:service-business": "npm run seed:service-business --workspace server",
    "seed:invoice-labels": "npm run seed:invoice-labels --workspace server",
    "seed:templates": "npm run seed:templates --workspace server",
    "seed:invoice-history": "npm run seed:invoice-history --workspace server",
    "seed:service-quotes": "npm run seed:service-quotes --workspace server",
    "seed:tickets": "npm run seed:tickets --workspace server",
    "seed:bids": "npm run seed:bids --workspace server",
    "seed:storefront": "npm run seed:storefront --workspace server",
    "drop:pictureless": "npm run drop:pictureless --workspace server",
    "seed:agreements": "npm run seed:agreements --workspace server",
    "seed:superadmin": "npm run seed:superadmin --workspace server",
    "backfill:competitors": "npm run backfill:competitors --workspace server --",
    "backfill:business": "npm run backfill:business --workspace server --",
    "backfill:invoice-kind": "npm run backfill:invoice-kind --workspace server --",
    "backfill:lineage": "npm run backfill:lineage --workspace server --",
    "backfill:cellvix-features": "npm run backfill:cellvix-features --workspace server --",
    "backfill:invoice-business": "npm run backfill:invoice-business --workspace server --",
    "backfill:referral-codes": "npm run backfill:referral-codes --workspace server --",
    "prune:imageless": "node scripts/prune-imageless.mjs",
    "shoot": "node scripts/shoot.mjs",
    "smoke": "node scripts/smoke.mjs",
    "smoke:clean": "node scripts/smoke-teardown.mjs",
    "a11y": "node scripts/a11y.mjs",
    "migrate": "npm run migrate --workspace server --"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "axe-core": "^4.13.0",
    "concurrently": "^9.1.2",
    "playwright": "^1.62.1",
    "sharp": "^0.35.3"
  },
  "engines": {
    "node": ">=20"
  }
}
