# =============================================================================
#  Kelinto environment
#
#  One `.env` at the repo root serves the server and the client build.
#  Copy this file to `.env`:
#    - DEVELOPMENT (your machine): the live block below works as-is once
#      MONGODB_URI is filled in.
#    - PRODUCTION (the Hostinger VPS): replace the development block with the
#      commented PRODUCTION block further down, uncomment it, and fill it in.
#
#  Never commit the real `.env`.
# =============================================================================


# =============================================================================
#  DEVELOPMENT
# =============================================================================

# ---- server ----
NODE_ENV=development
PORT=4000

# Atlas (or a local mongod). Scripts like `npm run seed` write to whatever this names.
MONGODB_URI=

JWT_SECRET=dev-only-change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
COOKIE_NAME=kelinto_session

# Empty = derived from JWT_SECRET. Encrypts provider credentials at rest.
SECRETS_KEY=

# The prefix every database name is built from: `<prefix>_control` for tenants,
# plans and super admins, `<prefix>_biz_<code>` for one business's records.
# To work on the live data locally, use the SAME prefix as the VPS (`cellvix`).
DB_PREFIX=kelinto

# ---- origins and hosts ----
# `*.localhost` resolves to your machine in every major browser, so the host
# split works locally with no hosts-file edit:
#   http://localhost:5173              any route (no split)
#   http://app.localhost:5173          the admin panel host
#   http://admin.localhost:5173        the super admin host
#   http://cellshoppe.localhost:5173   a business storefront
CLIENT_ORIGIN=http://localhost:5173
CORS_WILDCARD_ORIGINS=http://*.localhost:5173
# Leave both empty to keep every route on plain localhost.
PANEL_HOST=app.localhost
SUPERADMIN_HOST=admin.localhost
# Port the server uses when it builds links in development.
DEV_CLIENT_PORT=5173
# Where links in an email point when no business is in context.
# Empty = the first CLIENT_ORIGIN.
PUBLIC_ORIGIN=

# ---- mail ----
# Empty = every message is logged as not sent instead of going out. Safe locally.
SMTP_URL=
MAIL_FROM=Kelinto <billing@kelinto.com>
MAIL_FROM_ADMIN=Kelinto <admin@kelinto.com>
MAIL_FROM_PLATFORM=

# ---- messaging providers (optional) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
WHATSAPP_TOKEN=

# ---- payments ----
# Makes the MOCK gateway decline every charge, to exercise /payment-failed.
# A single order can be declined on demand with a delivery note starting DECLINE.
MOCK_PAYMENT_DECLINE=false

# ---- client (Vite: must be VITE_ prefixed, read at build time) ----
VITE_API_URL=/api


# =============================================================================
#  PRODUCTION (Hostinger VPS, Passenger, MongoDB Atlas)
#
#  Three settings are PINNED on the live VPS and must never be "fixed" to the
#  defaults: DB_PREFIX, COOKIE_NAME and MAIL_FROM / MAIL_FROM_ADMIN. See the
#  Deployment section of CLAUDE.md.
#
#  Rollout order for the host split (docs/SUBDOMAIN_SETUP.md):
#    1. DNS (@ and * A records), wildcard certificate, web server accepts *.kelinto.com
#    2. Set the origins block, restart, check https://cellshoppe.kelinto.com loads
#    3. Set PANEL_HOST and SUPERADMIN_HOST LAST, restart. Everyone signs in again.
#  Removing those two lines and restarting undoes step 3.
# =============================================================================

# ---- server ----
# NODE_ENV=production
# PORT=4000

# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/

# A long random string (e.g. `openssl rand -base64 48`). Changing it signs everyone out.
# JWT_SECRET=
# JWT_EXPIRES_IN=7d
# PINNED: changing it signs everyone out at once.
# COOKIE_NAME=kelinto_session

# Keep whatever the VPS already has. If it is empty, leave it empty: setting it
# later makes every stored provider key unreadable until it is re-entered.
# SECRETS_KEY=

# PINNED: names the existing databases. Changing it opens EMPTY ones.
# DB_PREFIX=cellvix

# ---- origins and hosts ----
# The apex, plus any existing origin still in use and every custom domain.
# CLIENT_ORIGIN=https://kelinto.com
# Every <slug>.kelinto.com (covers app. and admin. too). Also where storefront
# addresses such as cellshoppe.kelinto.com come from.
# CORS_WILDCARD_ORIGINS=https://*.kelinto.com
# Fallback for links built with no business in context. Without it, the first
# CLIENT_ORIGIN (the Kelinto landing page) is used. Check the live slug in
# super admin -> Tenants.
# PUBLIC_ORIGIN=https://cellshoppe.kelinto.com
# Set these two LAST, once DNS and TLS for both hosts work.
# PANEL_HOST=app.kelinto.com
# SUPERADMIN_HOST=admin.kelinto.com

# ---- mail ----
# SMTP_URL=smtps://<user>:<password>@mail.cellvix.ca:465
# PINNED: the envelope sender is the SMTP account's own address. Who a message
# is FROM is decided per business by services/sendingBusiness.js.
# MAIL_FROM=Cellvix <billing@cellvix.ca>
# MAIL_FROM_ADMIN=Cellvix <admin@cellvix.ca>
# Empty = supplier-account mail goes as "Kelinto" <MAIL_FROM_ADMIN address>.
# Only set a kelinto.com address once that domain sends mail (SPF/DKIM).
# MAIL_FROM_PLATFORM=

# ---- messaging providers (optional) ----
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# WHATSAPP_TOKEN=

# ---- payments ----
# Must stay false in production.
# MOCK_PAYMENT_DECLINE=false

# ---- client ----
# VITE_API_URL=/api
