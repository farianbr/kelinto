# ---- server ----
NODE_ENV=development
PORT=4000

MONGODB_URI=


JWT_SECRET=dev-only-change-me-to-a-long-random-string


SECRETS_KEY=
JWT_EXPIRES_IN=7d
COOKIE_NAME=kelinto_session

# The prefix every database name is built from: `<prefix>_control` for tenants,
# plans and super admins, `<prefix>_biz_<code>` for one business's records.
#
# Set this ONCE, when the installation is created, and then leave it alone. It
# chooses which databases the process opens; it does not rename anything. An
# installation already holding data keeps the prefix it was created under, and
# moving to a new one is a copy-verify-switch migration.
DB_PREFIX=kelinto


CLIENT_ORIGIN=http://localhost:5173

# Origins allowed by wildcard, comma separated, as `*.example.com`. Each admits
# ONE subdomain label of a domain you control, so a business added in the super
# admin console works without an env edit and a restart.
#
# Only the subdomain is wildcarded: `https://*.kelinto.com` admits
# shop.kelinto.com and refuses kelinto.com.attacker.example. The apex itself and
# any tenant on a CUSTOM domain still go in CLIENT_ORIGIN, explicitly.
# Empty means no wildcard at all, which is the safe default.
CORS_WILDCARD_ORIGINS=


SMTP_URL=
MAIL_FROM=Kelinto <billing@kelinto.com>
# Account mail (welcome, credentials) rather than money. Kept apart from
# MAIL_FROM so a welcome does not arrive from the billing desk.
MAIL_FROM_ADMIN=Kelinto <admin@kelinto.com>
# Where links in an email point. Defaults to the first CLIENT_ORIGIN.
PUBLIC_ORIGIN=

# Makes the MOCK payment gateway decline every charge, so /payment-failed can be
# exercised end to end. Leave false: a single order can be declined on demand by
# giving it a PO number that starts with DECLINE.
MOCK_PAYMENT_DECLINE=false

# ---- client (Vite: must be VITE_ prefixed) ----
VITE_API_URL=/api
